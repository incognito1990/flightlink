<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FlightLink" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.FlightLink.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/primary</item>
    </style>
</resources>
